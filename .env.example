# Optional — email sending (SMTP). Without it, emails stay in "non configuré" state and are never marked as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional — AI assistant & document extraction. Without it, the assistant uses its deterministic engine only.
ANTHROPIC_API_KEY=

# Optional — storage locations (defaults: data/recap.db and uploads/)
# DATABASE_FILE=
# UPLOAD_DIR=
